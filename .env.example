# Ejemplo para desarrollo local. Django carga .env automáticamente.
# Las variables ya definidas en el entorno tienen prioridad.
# Copia este archivo a .env y define una clave privada propia.
SECRET_KEY=
DJANGO_ENV=development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Para probar desde el móvil, añadir aquí la IP LAN real del ordenador,
# sin esquema ni puerto, y abrir el servidor en la interfaz de red.
CSRF_TRUSTED_ORIGINS=
TRUST_PROXY_HTTPS=False

# Producción: definir en Railway, sin subir .env ni reutilizar su clave local.
# DJANGO_ENV=production
# DEBUG=False
# ALLOWED_HOSTS: dominio definitivo real, sin https:// ni puerto.
# CSRF_TRUSTED_ORIGINS: orígenes necesarios con https://, sin rutas.
# Separar varios hosts u orígenes por comas. No utilizar '*'.
# TRUST_PROXY_HTTPS=True solo cuando el proxy sobrescriba X-Forwarded-Proto
# y todo el tráfico al proceso Django pase por ese proxy.
# HTTPS y las cookies Secure se activan automáticamente en production.

# PostgreSQL local: sustituye el usuario por el de tu instalación.
PGDATABASE=ketama_db
PGUSER=usuario_local
# Completa la contraseña solo si PostgreSQL la requiere.
PGPASSWORD=
PGHOST=localhost
PGPORT=5432
