# Ejemplo para desarrollo local. Django carga .env automáticamente.
# Las variables ya definidas en el entorno tienen prioridad.
# Copia este archivo a .env y define una clave privada propia.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL local: sustituye el usuario por el de tu instalación.
PGDATABASE=ketama_db
PGUSER=usuario_local
# Completa la contraseña solo si PostgreSQL la requiere.
PGPASSWORD=
PGHOST=localhost
PGPORT=5432
